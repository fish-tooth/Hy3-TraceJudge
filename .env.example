# Hy3 API configuration — copy this file to `.env` and fill in real values.
# WARNING: NEVER commit `.env` to git. API keys must come from environment only.

# Required. Your Hy3 API key.
HY3_API_KEY=

# Optional. OpenAI-compatible base URL (e.g. https://your-endpoint.example/v1).
HY3_BASE_URL=
# Optional. Model name to use.
HY3_MODEL=
